<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Text appearances (enlarged) ===================== -->
    <style name="TextAppearance.App.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/ts_display</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/ts_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/ts_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/ts_label</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/ts_caption</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="TextAppearance.App.ListItem" parent="TextAppearance.AppCompat.Menu">
        <item name="android:textSize">@dimen/ts_label</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.ListItem.Secondary" parent="TextAppearance.App.Caption">
        <item name="android:textSize">@dimen/ts_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===================== Enlarged default widgets ===================== -->
    <style name="Widget.App.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/ts_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_m</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">@dimen/ts_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_m</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.App.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:textSize">@dimen/ts_label</item>
    </style>

    <style name="Widget.App.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textSize">@dimen/ts_label</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textSize">@dimen/ts_label</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">@dimen/ts_body</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Widget.App.SpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textSize">@dimen/ts_label</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.App.SpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textSize">@dimen/ts_label</item>
    </style>

    <style name="TextAppearance.App.ActionBar.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">@dimen/ts_title_large</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="backgroundColor">@color/brand_primary</item>
        <item name="titleTextStyle">@style/TextAppearance.App.ActionBar.Title</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ===================== Base application theme ===================== -->
    <style name="Theme.OrbbecSdkExamples" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_primary_dark</item>

        <!-- Action bar -->
        <item name="actionBarStyle">@style/Widget.App.ActionBar</item>
        <item name="android:actionBarStyle">@style/Widget.App.ActionBar</item>

        <!-- Enlarged default control styles -->
        <item name="android:textViewStyle">@style/Widget.App.TextView</item>
        <item name="buttonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="android:checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="android:radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="switchStyle">@style/Widget.App.Switch</item>
        <item name="android:switchStyle">@style/Widget.App.Switch</item>
        <item name="editTextStyle">@style/Widget.App.EditText</item>
        <item name="android:editTextStyle">@style/Widget.App.EditText</item>
        <item name="android:spinnerItemStyle">@style/Widget.App.SpinnerItem</item>
        <item name="spinnerDropDownItemStyle">@style/Widget.App.SpinnerDropDownItem</item>
        <item name="android:dropDownItemStyle">@style/Widget.App.SpinnerDropDownItem</item>
        <item name="textAppearanceListItem">@style/TextAppearance.App.ListItem</item>
        <item name="textAppearanceListItemSecondary">@style/TextAppearance.App.ListItem.Secondary</item>
    </style>

    <!-- ===================== NoActionBar themes for redesigned pages ===================== -->
    <style name="Theme.OrbbecViewer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="android:textViewStyle">@style/Widget.App.TextView</item>
        <item name="buttonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="android:checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="android:radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="editTextStyle">@style/Widget.App.EditText</item>
        <item name="android:editTextStyle">@style/Widget.App.EditText</item>
        <item name="android:spinnerItemStyle">@style/Widget.App.SpinnerItem</item>
        <item name="spinnerDropDownItemStyle">@style/Widget.App.SpinnerDropDownItem</item>
    </style>

    <!-- Full-bleed black background for camera viewer pages -->
    <style name="Theme.OrbbecViewer.Viewer" parent="Theme.OrbbecViewer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="l">#CC000000</item>
    </style>
</resources>
