<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF111111"
    tools:context=".activity.CaptureDatasetActivity">

    <com.orbbec.orbbecsdkexamples.view.OBGLView
        android:id="@+id/capture_color_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#CC1E1E1E">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/capture_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在连接相机..."
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/capture_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="已采集: 0 组"
                android:textColor="#FF9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_capture"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:text="@string/capture_btn"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:background="@color/cat_amber" />
    </LinearLayout>

</LinearLayout>
