<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_feature"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/home_card_radius"
    app:cardElevation="@dimen/home_card_elevation"
    app:cardStrokeColor="@color/divider"
    app:cardStrokeWidth="@dimen/home_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sp_14">

        <ImageView
            android:id="@+id/iv_feature_icon"
            android:layout_width="@dimen/home_icon_size"
            android:layout_height="@dimen/home_icon_size"
            android:padding="12dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_feature_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_12"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/ts_body"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/tv_feature_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_4"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/ts_caption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
