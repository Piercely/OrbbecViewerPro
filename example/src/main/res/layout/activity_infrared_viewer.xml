<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.orbbec.orbbecsdkexamples.view.OBGLView
        android:id="@+id/irview_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/viewer_top_scrim"
        android:fitsSystemWindows="true"
        android:minHeight="@dimen/viewer_bar_height"
        android:orientation="vertical"
        android:paddingStart="@dimen/sp_6"
        android:paddingEnd="@dimen/sp_12"
        android:paddingBottom="@dimen/sp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/viewer_touch"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/viewer_touch"
                android:layout_height="@dimen/viewer_touch"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/viewer_back"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_4"
                android:text="@string/viewer_ir_title"
                android:textColor="@color/text_on_dark"
                android:textSize="@dimen/ts_title_large"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_waiting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:text="@string/viewer_waiting"
        android:textColor="#CCFFFFFF"
        android:textSize="@dimen/ts_body"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_capture_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sp_12"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:text="@string/viewer_capture_hint"
        android:textColor="#E6FFFFFF"
        android:textSize="@dimen/ts_caption"
        app:layout_constraintBottom_toTopOf="@id/btn_shutter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/btn_shutter"
        android:layout_width="@dimen/viewer_shutter_size"
        android:layout_height="@dimen/viewer_shutter_size"
        android:layout_marginBottom="@dimen/sp_28"
        android:background="@drawable/bg_shutter"
        android:clickable="true"
        android:contentDescription="@string/viewer_shutter"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="18dp"
            android:src="@drawable/ic_shutter_aperture" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
